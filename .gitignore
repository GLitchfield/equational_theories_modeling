# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.env

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
*:Zone.Identifier

# data/raw — symlinks to external projects, never committed
data/raw/*
!data/raw/.gitkeep

# data/processed — generated PyG caches, large binaries
data/processed/*
!data/processed/.gitkeep

# data/splits — committed (small JSON, needed for reproducibility),
#               so NOT ignored.

# Outputs — checkpoints + figures: generated, not committed.
# (Path repointed Phase 5c: outputs/ → embeddings/outputs/.)
embeddings/outputs/checkpoints/*
embeddings/outputs/figures/*
!embeddings/outputs/checkpoints/.gitkeep
!embeddings/outputs/figures/.gitkeep

# embeddings/outputs/embeddings/ holds promoted embedding artifacts.
# The .npy embeddings are large + regenerable from the source
# checkpoint, so they stay out of git. The model card AND the source
# checkpoint (.pt) travel with the artifact so it's fully reproducible
# from git alone.
embeddings/outputs/embeddings/**/*.npy

# per-run artifacts: large parquet + npy stay out of git (regenerable
# from checkpoints via scripts/save_predictions.py and save_embeddings.py);
# the small JSON summaries, analysis outputs, and figures are tracked.
# Patterns cover both layouts: legacy failure_analysis*/ and
# the runs/<name>/ convention adopted 2026-05-10.
embeddings/outputs/failure_analysis*/*.parquet
embeddings/outputs/failure_analysis*/*.npy
embeddings/outputs/runs/*/*.parquet
embeddings/outputs/runs/*/*.npy

# Probing embeddings — large (~55 MB), regenerable from
# scripts/extract_probe_embeddings.py. Probe-result JSONs in
# embeddings/outputs/probing/results/ ARE committed (the actual deliverable).
embeddings/outputs/probing/embeddings/*.npy

# wandb local logs
wandb/

# trash — kept around as a directory but contents are not committed by default
trash/*
!trash/.gitkeep

# Logs
*.log

# Notebook checkpoints
.ipynb_checkpoints/

# et_studies/*/data — generated parquets per study, large binaries
et_studies/*/data/*
!et_studies/*/data/.gitkeep

# pyenv local
.python-version

# Lean Lake build artifacts
.lake/
lake-packages/
*.olean
