# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.env

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
*:Zone.Identifier

# data/raw — symlinks to external projects, never committed
data/raw/*
!data/raw/.gitkeep

# data/processed — generated PyG caches, large binaries
data/processed/*
!data/processed/.gitkeep

# data/splits — committed (small JSON, needed for reproducibility),
#               so NOT ignored.

# Outputs — checkpoints, embeddings, figures all generated, not committed
outputs/checkpoints/*
outputs/embeddings/*
outputs/probing_results/*
outputs/figures/*
!outputs/checkpoints/.gitkeep
!outputs/embeddings/.gitkeep
!outputs/probing_results/.gitkeep
!outputs/figures/.gitkeep

# per-run artifacts: large parquet + npy stay out of git (regenerable
# from checkpoints via scripts/save_predictions.py and save_embeddings.py);
# the small JSON summaries, analysis outputs, and figures are tracked.
# Patterns cover both layouts: legacy outputs/failure_analysis*/ and
# the new outputs/runs/<name>/ convention adopted 2026-05-10.
outputs/failure_analysis*/*.parquet
outputs/failure_analysis*/*.npy
outputs/runs/*/*.parquet
outputs/runs/*/*.npy

# Probing embeddings — large (~55 MB), regenerable from
# scripts/extract_probe_embeddings.py. Probe-result JSONs in
# outputs/probing/results/ ARE committed (small, the actual deliverable).
outputs/probing/embeddings/*.npy

# wandb local logs
wandb/

# trash — kept around as a directory but contents are not committed by default
trash/*
!trash/.gitkeep

# Logs
*.log

# Notebook checkpoints
.ipynb_checkpoints/
